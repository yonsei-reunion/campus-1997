    {"name": "game/basketball", "doc": "대강당 앞 농구장: 공을 주워 골대 앞에서",
     "walk": {"x": 21.9, "y": 2.5, "yaw": 0, "dist": 6, "lift": 0.15}, "size": [1388, 747],
     "eval": "(() => { const Y = window.__y97, b = Y.ball; Y.player.teleport(b.pos.x, -b.pos.z, 0); })()",
     "keys": ["KeyE"], "keyWait": 800,
     "post": "(() => { const Y = window.__y97, p = Y.player, h = Y.ball.nearestHoop(60); const c = [21.9, 2.5]; const hx = h.rim.x, hy = -h.rim.z; const dx = c[0] - hx, dy = c[1] - hy, d = Math.hypot(dx, dy); const x = hx + dx / d * 7, y = hy + dy / d * 7; p.teleport(x, y, -Math.atan2(hx - x, hy - y)); p.cam.dist = 6; p.cam.lift = 0.15; p.cam.ready = false; })()",
     "postWait": 4500,
     "out": [{"path": "docs/game/basketball.jpg"}]},
